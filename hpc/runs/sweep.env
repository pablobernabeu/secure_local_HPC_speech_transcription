# shellcheck shell=bash
# Invocation behind output/evaluation/sweep_aggregate.csv and .json, the
# Large v3 test-clean reports in output/evaluation/sweep_reports_postfix/,
# the Large v3 AMI raw and whisper_norm reports of 8917985's task 1 in
# output/evaluation/sweep_reports_postfix_ami/, under the sweep's names,
# and the manuscript's headline pair, output/evaluation/wer_report.csv and
# wer_summary.json, which are the raw report and summary of 8917985's task 0
# (wer_*_librispeech_whisper-large-v3.*) copied unchanged, except that git
# stores every report with LF line endings where ARC's copies have CRLF.
#
# Three array jobs, 2026-09-28, one per model, each --array=0-4%2 (one suite
# per task) at code 6f9bf56 with a clean tree, as every task's environment
# record and every summary's run_metadata say:
#   8917985  openai/whisper-large-v3        educ-intract  Tesla V100-PCIE-32GB
#   8917986  openai/whisper-medium          educ-lift     NVIDIA L40S
#   8917987  distil-whisper/distil-large-v3 educ-intract  NVIDIA L40S
# Each ran after a SWEEP_LIMIT=10 pre-flight of the same model (8913987,
# 8913988, 8913989) through --dependency=afterok. The 255 summaries were
# aggregated locally by evaluation.sweep_aggregate at 7214e77; the JSON's
# provenance block holds the SHA-256 of every one.
#
# The script's defaults differ in two ways: it decodes Large v3 only, and
# writes to the evaluation directory itself. DUMP_HYPOTHESES=1 kept the
# hypotheses, so a later change to the clean-up stages is rescored on CPU
# from wer_hypotheses_<suite>_<model>.csv without decoding again.
#
# Reproduce (from the repository root on ARC), once per model, naming the
# card the original ran on:
#   ( set -a; . hpc/runs/sweep.env || exit 1; set +a
#     sbatch --account=educ-intract --gres=gpu:v100:1 hpc/submit_sweep.sh )
#   ( set -a; . hpc/runs/sweep.env || exit 1
#     SWEEP_MODEL=openai/whisper-medium; set +a
#     sbatch --account=educ-lift --gres=gpu:l40s:1 hpc/submit_sweep.sh )
#   ( set -a; . hpc/runs/sweep.env || exit 1
#     SWEEP_MODEL=distil-whisper/distil-large-v3; set +a
#     sbatch --account=educ-intract --gres=gpu:l40s:1 hpc/submit_sweep.sh )
# then, once the three jobs have finished, aggregate the same directory:
#   ( set -a; . hpc/runs/sweep.env || exit 1; set +a
#     SWEEP_DIR=$SWEEP_OUTPUT_DIR sbatch hpc/aggregate_sweep.sh )
#
# The aggregation sources the record too. The subshells above leave
# SWEEP_OUTPUT_DIR unset in the calling shell, and aggregate_sweep.sh reads
# an empty SWEEP_DIR as its default, which is the original's directory.
#
# SWEEP_OUTPUT_DIR below sends a reproduction to repro/sweep/, so it cannot
# overwrite the original, which is at
# ${DATA}/speech_transcription_env/output/evaluation/audit2026/sweep.
SWEEP_MODEL=openai/whisper-large-v3
DUMP_HYPOTHESES=1
SWEEP_OUTPUT_DIR="${DATA}/speech_transcription_env/output/evaluation/repro/sweep"
